
{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://riesgos-api.vercel.app/api/auth/:path*"
    },
    {
      "source": "/api/creditos",
      "destination": "https://riesgos-api.vercel.app/api/creditos"
    },
    {
      "source": "/api/creditos/:path*",
      "destination": "https://riesgos-api.vercel.app/api/creditos/:path*"
    },
    {
      "source": "/api/owner/:path*",
      "destination": "https://riesgos-api.vercel.app/api/owner/:path*"
    },
    {
      "source": "/",
      "destination": "https://riesgos-api.vercel.app/api/app"
    }
  ]
}
